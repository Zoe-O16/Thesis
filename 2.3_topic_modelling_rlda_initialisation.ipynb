   "outputs": [],
   "source": [
    "# Cell 13: K sweep\n",
    "\n",
    "K_SWEEP_CSV = OUT_DIR / \"rlda_k_sweep_cosine.csv\"\n",
    "RESTART     = True\n",
    "\n",
    "if K_SWEEP_CSV.exists() and not RESTART:\n",
    "    _existing = pd.read_csv(K_SWEEP_CSV)\n",
    "    _done     = set(zip(_existing[\"K\"].astype(int)))\n",
    "    print(f\"Resuming: {len(_done)} K values already done.\")\n",
    "else:\n",
    "    _existing = pd.DataFrame()\n",
    "    _done     = set()\n",
    "    pd.DataFrame(columns=[\"K\", \"mean_cosine\", \"std_cosine\", \"mean_cv\", \"std_cv\"]).to_csv(\n",
    "        K_SWEEP_CSV, index=False\n",
    "    )\n",
    "\n",
    "k_sweep_records = []\n",
    "\n",
    "for k in K_VALUES:\n",
    "    if (k,) in _done:\n",
    "        print(f\"K={k} already done).\")\n",
    "        continue\n",
    "    print(f\"K={k}  fitting LDAPrototype ({N_SEEDS} seeds, max_iter={MAX_ITER}) ...\", end=\" \")\n",
    "\n",
    "    all_phis, proto_phi = fit_ldaprototype(X_init, init_vocab, k=k, n_seeds=N_SEEDS, max_iter=MAX_ITER)\n",
    "\n",
    "    mean_cos, std_cos = mean_cross_seed_cosine(all_phis)\n",
    "\n",
    "    topics             = get_top_words_per_topic(proto_phi, init_vocab)\n",
    "    mean_coh, std_coh  = compute_cv_coherence(topics[\"top_words_list\"].tolist(), coherence_token_lists)\n",
    "\n",
    "    print(f\"cosine={mean_cos:.4f}±{std_cos:.4f}  C_v={mean_coh:.4f}±{std_coh:.4f}\")\n",
    "\n",
    "    rec = {\"K\": k, \"mean_cosine\": mean_cos, \"std_cosine\": std_cos, \"mean_cv\": mean_coh, \"std_cv\": std_coh}\n",
    "    pd.DataFrame([rec]).to_csv(K_SWEEP_CSV, mode=\"a\", header=False, index=False)\n",
    "    k_sweep_records.append(rec)\n",
    "\n",
    "k_sweep_df = pd.read_csv(K_SWEEP_CSV).sort_values(\"K\").reset_index(drop=True)\n",
    "print()\n",
    "print(k_sweep_df.to_string(index=False))"
   ]
  },
