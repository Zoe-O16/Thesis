    ")\n",
    "\n",
    "topics_diagnostics[\"per_topic_df\"].to_csv(OUT_DIR / \"stage2_4_baseline_topic_diagnostics.csv\", index=False)\n",
    "\n",
    "baseline_diagnostics = {\n",
    "    \"topic_entropy\":     topics_diagnostics[\"per_topic_df\"][\"entropy\"].tolist(),\n",
    "    \"excl_raw\":          topics_diagnostics[\"per_topic_df\"][\"excl_raw\"].tolist(),\n",
    "    \"excl_rel\":          topics_diagnostics[\"per_topic_df\"][\"excl_rel\"].tolist(),\n",
    "    \"topic_size_share\":  topics_diagnostics[\"per_topic_df\"][\"size_share\"].tolist(),\n",
    "    **topics_diagnostics[\"corpus\"],\n",
    "}\n",
    "\n",
    "c = topics_diagnostics[\"corpus\"]\n",
    "#   (1 − mean pairwise cosine)\n",
