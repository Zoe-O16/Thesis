    "topics_raw_15 = get_top_words_per_topic(proto_components, init_vocab, n=N_DIAGNOSTICS)\n",
    "topics_rel_15 = get_top_words_per_topic(proto_components, init_vocab, n=N_DIAGNOSTICS, rel=rel)\n",
