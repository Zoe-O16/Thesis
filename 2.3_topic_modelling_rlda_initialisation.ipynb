    "# Cell 18: LDAvis with lambda slider\n",
    "\n",
    "doc_topic_matrix = X_init @ proto_components.T\n",
    "doc_topic_norm   = doc_topic_matrix / doc_topic_matrix.sum(axis=1, keepdims=True).clip(min=1e-12)\n",
    "\n",
    "vis_data = pyLDAvis.prepare(\n",
    "    topic_term_dists = proto_components,\n",
    "    doc_topic_dists  = doc_topic_norm,\n",
    "    doc_lengths      = X_init.sum(axis=1),\n",
    "    vocab            = init_vocab,\n",
    "    term_frequency   = X_init.sum(axis=0),\n",
    "    lambda_step      = 0.01,\n",
    "    sort_topics      = False,\n",
    "    mds              = \"pcoa\",\n",
    ")\n",
    "pyLDAvis.save_html(vis_data, str(OUT_DIR / \"ldavis_init.html\"))\n",
    "print(f\"LDAvis saved → {OUT_DIR}/ldavis_init.html\")\n",
    "vis_data"
   ]
