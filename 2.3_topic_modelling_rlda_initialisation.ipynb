   "source": [
    "# Cell 17: Diagnostic helper function\n",
    "\n",
    "def compute_topic_diagnostics(\n",
    "    phi: np.ndarray,\n",
    "    X: np.ndarray,\n",
    "    top_words_raw: list[list[str]],\n",
    "    top_words_rel: list[list[str]],\n",
    "    token_lists: list[list[str]],\n",
    "    K: int,\n",
    ") -> dict:\n",
    "    \"\"\"\n",
    "    Compute per-topic and corpus-level diagnostics over two word list rankings\n",
    "    \"\"\"\n",
    "\n",
    "    #Entropy\n",
    "    topic_entropy = -(phi * np.log(phi.clip(min=1e-12))).sum(axis=1)\n",
    "\n",
    "    def _exclusivity(word_lists):\n",
    "        sets = [set(wl) for wl in word_lists]\n",
    "        return np.array([\n",
    "            len(sets[k] - set().union(*[sets[j] for j in range(K) if j != k]))\n",
    "            / len(word_lists[k])\n",
    "            for k in range(K)\n",
    "        ])\n",
    "\n",
    "    excl_raw = _exclusivity(top_words_raw)\n",
    "    excl_rel = _exclusivity(top_words_rel)\n",
    "\n",
    "    # C_v coherence\n",
    "    coh_raw_mean, coh_raw_std = compute_cv_coherence(top_words_raw, token_lists)\n",
    "    coh_rel_mean, coh_rel_std = compute_cv_coherence(top_words_rel, token_lists)\n",
    "\n",
    "    # Corpus-level distinctiveness\n",
    "    cos_sim = cosine_similarity(phi)\n",
    "    np.fill_diagonal(cos_sim, np.nan)\n",
    "    distinctiveness = 1 - float(np.nanmean(cos_sim))\n",
    "\n",
    "    # Topic size\n",
    "    doc_topic  = X @ phi.T\n",
    "    topic_size = doc_topic.sum(axis=0)\n",
    "    topic_size = topic_size / topic_size.sum()\n",
    "\n",
    "    per_topic_df = pd.DataFrame({\n",
    "        \"topic\":        range(K),\n",
    "        \"entropy\":      topic_entropy.round(4),\n",
    "        \"excl_raw\":     excl_raw.round(4),\n",
    "        \"excl_rel\":     excl_rel.round(4),\n",
    "        \"size_share\":   topic_size.round(4),\n",
    "    })\n",
    "\n",
    "    corpus = {\n",
    "        \"distinctiveness\":   distinctiveness,\n",
    "        \"coh_raw_mean\":      coh_raw_mean,\n",
    "        \"coh_raw_std\":       coh_raw_std,\n",
    "        \"coh_rel_mean\":      coh_rel_mean,\n",
    "        \"coh_rel_std\":       coh_rel_std,\n",
    "    }\n",
    "\n",
    "    return {\"per_topic_df\": per_topic_df, \"corpus\": corpus}"
   ]
  },
