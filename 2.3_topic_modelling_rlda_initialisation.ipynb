    "# Cell 10: Build bag of words matrix for init period\n",
    "\n",
    "vocab_index = {term: i for i, term in enumerate(init_vocab)}\n",
    "V = len(init_vocab)\n",
    "\n",
    "X_init = np.zeros((len(init_token_lists), V), dtype=np.int32)\n",
    "for d, toks in enumerate(init_token_lists):\n",
    "    for tok in toks:\n",
    "        tok_l = tok.lower()\n",
    "        if tok_l in vocab_index:\n",
    "            X_init[d, vocab_index[tok_l]] += 1\n",
    "\n",
    "print(f\"Init BOW matrix: {X_init.shape}\")\n",
