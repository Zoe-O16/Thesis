    "# Cell 8: Slice init period\n",
    "\n",
    "init_mask = df[\"_date\"] <= INIT_DATE\n",
    "init_df   = df[init_mask].copy()\n",
    "\n",
    "print(f\"Init period: {init_df['_date'].min().date()} → {INIT_DATE.date()}\")\n",
    "print(f\"Init docs  : {len(init_df)} / {len(df)} total\")"
   ]
