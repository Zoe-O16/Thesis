    "## 4. K sweep on init period"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a001b011",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 11: K-sweep helpers\n",
    "\n",
    "def bow_to_lda_docs(X: np.ndarray) -> ro.ListVector:\n",
    "    \"\"\"Convert to R data format\"\"\"\n",
    "    docs = {}\n",
    "    for d in range(X.shape[0]):\n",
    "        row = X[d]\n",
    "        nz  = np.where(row > 0)[0].astype(np.int32)\n",
    "        cnt = row[nz].astype(np.int32)\n",
    "        if len(nz) == 0:\n",
    "            mat = ro.r.matrix(ro.IntVector([]), nrow=2, ncol=0)\n",
    "        else:\n",
    "            indices = np.repeat(nz, cnt)\n",
    "            ones    = np.ones(len(indices), dtype=np.int32)\n",
    "            flat = np.column_stack([indices, ones]).ravel().tolist()\n",
    "            mat  = ro.r.matrix(ro.IntVector(flat), nrow=2, ncol=len(indices))\n",
    "        docs[str(d)] = mat\n",
    "    return ro.ListVector(docs)\n",
    "\n",
    "\n",
    "\n",
    "def get_top_words_per_topic(components: np.ndarray, feature_names: list, n: int = N_TOP_WORDS, rel: np.ndarray = None) -> pd.DataFrame:\n",
    "    rows = []\n",
    "    for idx, topic in enumerate(components):\n",
    "        top_idx = rel[idx].argsort()[:-n - 1:-1] if rel is not None else topic.argsort()[:-n - 1:-1]\n",
    "        words   = [feature_names[i] for i in top_idx]\n",
    "        rows.append({\"topic_id\": idx, \"top_words\": \", \".join(words), \"top_words_list\": words})\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def compute_cv_coherence(topic_word_lists: list, token_lists: list) -> tuple[float, float]:\n",
    "    \"\"\"Returns (mean_cv, std_cv) across topics.\"\"\"\n",
    "    token_lists = [t for t in token_lists if t]\n",
    "    if not token_lists:\n",
    "        return float(\"nan\"), float(\"nan\")\n",
    "    dictionary = Dictionary(token_lists)\n",
    "    corpus     = [dictionary.doc2bow(t) for t in token_lists]\n",
    "    cm = CoherenceModel(\n",
    "        topics=topic_word_lists, texts=token_lists,\n",
    "        corpus=corpus, dictionary=dictionary, coherence=\"c_v\",\n",
    "    )\n",
    "    per_topic = cm.get_coherence_per_topic()\n",
    "    return float(np.mean(per_topic)), float(np.std(per_topic))\n",
    "\n",
    "\n",
    "def mean_cross_seed_cosine(components_list: list) -> tuple[float, float]:\n",
    "    \"\"\"Returns (mean, std) of pairwise cosine similarity across seeds after Hungarian matching.\"\"\"\n",
    "    n = len(components_list)\n",
    "    if n < 2:\n",
    "        return float(\"nan\"), float(\"nan\")\n",
    "    sims = []\n",
    "    for i in range(n):\n",
    "        for j in range(i + 1, n):\n",
    "            A = components_list[i]\n",
    "            B = components_list[j]\n",
    "            C = cosine_similarity(A, B)\n",
    "            row_ind, col_ind = linear_sum_assignment(-C)\n",
    "            sims.append(C[row_ind, col_ind].mean())\n",
    "    return float(np.mean(sims)), float(np.std(sims))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "12d0edfb",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 12b: fit_ldaprototype — rpy2 wrapper around ldaPrototype::LDAPrototype\n",
    "\n",
    "\n",
    "_r_get_lda_topics = ro.r(\"function(result, i) result$lda[[i]]$topics\")\n",
    "_r_get_protoid    = ro.r(\"function(result) as.integer(result$protoid)\")\n",
    "\n",
    "\n",
    "def fit_ldaprototype(X: np.ndarray, vocab: list, k: int, n_seeds: int, max_iter: int):\n",
    "    r_docs  = bow_to_lda_docs(X)\n",
    "    r_vocab = ro.StrVector(vocab)\n",
    "\n",
    "    result = ldaprototype.LDAPrototype(\n",
    "        docs=r_docs,\n",
    "        vocabLDA=r_vocab,\n",
    "        K=k,\n",
    "        n=n_seeds,\n",
    "        seeds=ro.IntVector(list(range(n_seeds))),\n",
    "        **{\"num.iterations\": max_iter},\n",
    "        keepLDAs=True,\n",
    "        keepTopics=True,\n",
    "        progress=False,\n",
    "    )\n",
    "\n",
    "    with localconverter(ro.default_converter + numpy2ri.converter):\n",
    "        all_phis = []\n",
    "        # 1 based (matches r indexing)\n",
    "        for i in range(1, n_seeds + 1):\n",
    "            phi_r = _r_get_lda_topics(result, i)\n",
    "            phi   = np.array(phi_r)\n",
    "            phi   = phi / phi.sum(axis=1, keepdims=True).clip(min=1e-12)\n",
    "            all_phis.append(phi)\n",
    "\n",
    "        protoid     = int(_r_get_protoid(result)[0])\n",
    "        proto_phi_r = _r_get_lda_topics(result, protoid)\n",
    "        proto_phi   = np.array(proto_phi_r)\n",
    "        proto_phi   = proto_phi / proto_phi.sum(axis=1, keepdims=True).clip(min=1e-12)\n",
    "\n",
    "    return all_phis, proto_phi"
   ]
  },
