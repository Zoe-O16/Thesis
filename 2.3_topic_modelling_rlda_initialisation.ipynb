    "# Cell 16: Fit canonical LDAPrototype model at chosen K & inspect top words\n",
    "\n",
    "print(f\"Fitting LDAPrototype at K={CHOSEN_K_RLDA}\")\n",
    "_, proto_components = fit_ldaprototype(X_init, init_vocab, k=CHOSEN_K_RLDA, n_seeds=N_SEEDS, max_iter=MAX_ITER)\n",
    "\n",
    "phi  = proto_components\n",
    "p_w  = X_init.sum(axis=0) / X_init.sum()\n",
    "\n",
    "log_phi = np.log(phi.clip(min=1e-12))\n",
    "log_pw  = np.log(p_w.clip(min=1e-12))\n",
    "rel     = LAMBDA_VIS * log_phi + (1 - LAMBDA_VIS) * (log_phi - log_pw)  # (K, V)\n",
    "\n",
    "topics_raw = get_top_words_per_topic(proto_components, init_vocab)\n",
    "topics_rel = get_top_words_per_topic(proto_components, init_vocab, rel=rel)\n",
    "\n",
    "print(f\"\\nRaw ranking (λ=1.0)\")\n",
    "for _, row in topics_raw.iterrows():\n",
    "    print(f\"Topic {row['topic_id']:>2}: {row['top_words']}\")\n",
    "\n",
    "print(f\"\\nRelevance ranking (λ={LAMBDA_VIS})\")\n",
    "for _, row in topics_rel.iterrows():\n",
    "    print(f\"Topic {row['topic_id']:>2}: {row['top_words']}\")"
