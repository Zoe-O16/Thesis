    "print(f\"Mean C_v coherence (raw φ)   : {c['coh_raw_mean']:.4f} ± {c['coh_raw_std']:.4f}  [top-{N_DIAGNOSTICS}, λ=1.0]\")\n",
    "print(f\"Mean C_v coherence (rel)     : {c['coh_rel_mean']:.4f} ± {c['coh_rel_std']:.4f}  [top-{N_DIAGNOSTICS}, λ={LAMBDA_VIS}]\")\n",
    "print()\n",
    "print(topics_diagnostics[\"per_topic_df\"].to_string(index=False))"
   ]
