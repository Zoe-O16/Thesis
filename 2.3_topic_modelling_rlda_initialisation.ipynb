    "# Cell 12: Token lists for coherence (restricted to init vocab)\n",
    "\n",
    "init_vocab_set = set(init_vocab)\n",
    "coherence_token_lists = [\n",
    "    [t.lower() for t in toks if t.lower() in init_vocab_set]\n",
    "    for toks in init_token_lists\n",
    "]\n"
   ]
