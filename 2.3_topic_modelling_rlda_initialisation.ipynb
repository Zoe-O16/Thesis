   "source": [
    "# Cell 5: Init period vocabulary coverage sweep\n",
    "\n",
    "records = []\n",
    "for cand_date in INIT_DATE_CANDIDATES:\n",
    "    cand_ts     = pd.Timestamp(cand_date)\n",
    "    cand_df     = df[df[\"_date\"] <= cand_ts]\n",
    "    cand_tokens = [toks if isinstance(toks, list) else [] for toks in cand_df[\"noun_tokens\"]]\n",
    "\n",
    "    present: Counter = Counter()\n",
    "    for toks in cand_tokens:\n",
    "        present.update({t.lower() for t in toks if t.lower() in global_vocab_terms})\n",
    "\n",
    "    n_present = len(present)\n",
    "    present_cov = n_present / len(global_vocab_terms)\n",
    "\n",
    "    records.append({\n",
    "        \"init_date\":    cand_date,\n",
    "        \"n_docs\":       len(cand_df),\n",
    "        \"n_present\":    n_present,\n",
    "        \"present_cov\":  present_cov,\n",
    "    })\n",
    "    print(f\"{cand_date}  docs={len(cand_df):>5}  \"\n",
    "          f\"present={n_present:>5}  present_cov={present_cov:.1%}\")\n",
    "\n",
    "init_sweep_df = pd.DataFrame(records)\n",
    "init_sweep_df.to_csv(OUT_DIR / \"rlda_init_sweep.csv\", index=False)"
   ]
